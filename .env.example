# The password OBS streams with, and the relay reads the stream back with.
# Letters, digits and _ are safest: MediaMTX refuses some characters, such as
# /, and in OBS's stream key a + would read as a space.
INBOUND_STREAM_KEY=

# Where to send it: any platform that takes RTMP or RTMPS, numbered from 1.
# One without a key is left out. Without a resolution, bitrate or preset
# it's sent as it comes in, costing almost no CPU; with any of them, it's
# re-encoded at that. See "Where it sends" in the README.

# YouTube, as it comes in.
# Key: YouTube Studio > Go live > Stream key
OUTPUT_1_NAME=YouTube
OUTPUT_1_URL=rtmp://a.rtmp.youtube.com/live2
OUTPUT_1_KEY=
# OUTPUT_1_RESOLUTION=
# OUTPUT_1_BITRATE=
# OUTPUT_1_PRESET=

# Twitch, scaled down and re-encoded, as it takes less than YouTube.
# Key: Twitch dashboard > Settings > Stream > Primary stream key. Twitch
# lists servers nearer you at
# https://help.twitch.tv/s/twitch-ingest-recommendation
OUTPUT_2_NAME=Twitch
OUTPUT_2_URL=rtmp://live.twitch.tv/app
OUTPUT_2_KEY=
OUTPUT_2_RESOLUTION=1920x1080
OUTPUT_2_BITRATE=6000k
# veryfast looks better than the usual superfast, for about twice the CPU
# OUTPUT_2_PRESET=superfast

# Any other, such as Kick, with the address and key from its dashboard
# OUTPUT_3_NAME=Kick
# OUTPUT_3_URL=rtmps://…/app
# OUTPUT_3_KEY=
# OUTPUT_3_RESOLUTION=
# OUTPUT_3_BITRATE=
# OUTPUT_3_PRESET=

# Where the relay writes whether it's live, as JSON, for a dashboard to read
# STATUS_FILE=/tmp/relay/status.json

# How much it logs: debug (everything FFmpeg says too), info, warn or error
# LOG_LEVEL=info

# Record what comes in to ./recordings on the server, a file an hour. It
# takes room: a 16 Mb/s stream is about 7 GB an hour.
# RECORD=false
# How long recordings are kept, as 7d, 12h or 30m; 0s keeps them for good
# RECORD_KEEP=7d

# Encrypts what OBS sends by SRT, if set, given to OBS too (see the README):
# 10 to 79 characters, or MediaMTX won't start at all. RTMP isn't encrypted
# either way.
# SRT_PASSPHRASE=

# While OBS has dropped out, a clip plays in its place, so the stream goes
# on, if true. OBS must send stereo audio at 48 kHz, as it does unless
# changed, or MediaMTX turns it away. See "Fallback" in the README.
# FALLBACK=false
# How long the clip can play before the stream ends, as 90s, 5m or 1h
# FALLBACK_FOR=5m
# Which clip in ./fallback, if your own
# FALLBACK_FILE=be-right-back.mp4
