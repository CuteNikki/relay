# The password OBS streams with, and the relay reads the stream back with.
# Letters, digits and _ are safest: MediaMTX refuses some characters, such as
# /, and in OBS's stream key a + would read as a space.
INBOUND_STREAM_KEY=

# Where to send it: set either or both. A platform with no key is left out.
# YouTube Studio → Go live → Stream key
YOUTUBE_STREAM_KEY=
# Twitch dashboard → Settings → Stream → Primary stream key
TWITCH_STREAM_KEY=

# Twitch's copy is scaled down and re-encoded, as Twitch takes less than
# YouTube. These are the defaults.
# TWITCH_RESOLUTION=1920x1080
# TWITCH_BITRATE=6000k

# Where each platform takes streams, if not its default. Twitch lists servers
# nearer you at https://help.twitch.tv/s/twitch-ingest-recommendation
# TWITCH_INGEST=rtmp://live.twitch.tv/app
# YOUTUBE_INGEST=rtmp://a.rtmp.youtube.com/live2

# Where the relay writes whether it's live, as JSON, for a dashboard to read
# STATUS_FILE=/tmp/relay/status.json
